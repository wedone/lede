#!/bin/sh
# MASELinK AP2600IFM (ar71xx 版):
#   - 默认 LAN IP 改为 192.168.3.1/24, 避免与光猫默认 192.168.1.1 冲突;
#   - 默认主机名改为 AP2600IFM (替代 config_generate 生成的 LEDE)。
# 与自研 ath79 版(ap2600 分支 90_maselink_ap2600ifm)保持一致, 保证 AB 实测变量单一。
# 仅在首次启动(firstboot)时生效; 用户已保存的配置不会被覆盖。

board="$(board_name)"
case "$board" in
        maselink-ap2600ifm)
                # 默认主机名直接改为 AP2600IFM (替代 config_generate 生成的 LEDE)
                uci set system.@system[0].hostname='AP2600IFM'
                # 默认时区 CST-8 (default-settings 包已剔除, 补位其 zzz-default-settings 行为)
                uci set system.@system[0].timezone='CST-8'
                uci set system.@system[0].zonename='Asia/Shanghai'
                uci commit system

                # 默认主题 luci-theme-bootstrap (OpenWrt 官方默认; 显式设置避免依赖 dispatcher 回退)
                uci set luci.themes.Bootstrap='/luci-static/bootstrap'
                uci set luci.main.mediaurlbase='/luci-static/bootstrap'
                uci set luci.main.theme='bootstrap'
                # B1: 默认语言 zh_cn (default-settings 包已剔除, 补位)
                uci set luci.main.lang='zh_cn'
                uci commit luci

                # 默认 LAN IP 192.168.3.1/24: 仅在仍是默认 192.168.1.1 (或未设置) 时写入
                if [ -z "$(uci -q get network.lan.ipaddr)" ] || \
                   [ "$(uci -q get network.lan.ipaddr)" = "192.168.1.1" ]; then
                        uci set network.lan.ipaddr='192.168.3.1'
                        uci set network.lan.netmask='255.255.255.0'
                        uci commit network
                fi

                # 无线默认启用 (default-settings 包已剔除, 补位: 移除 radio 默认 disabled 行为)
                sed -i '/set wireless.radio${devidx}.disabled/d' /lib/wifi/mac80211.sh
                [ -s /etc/config/wireless ] && sed -i '/option disabled/d' /etc/config/wireless

                # 默认开启 802.11k/11v/11r 无缝漫游 (与 ath79 版一致; 编译含 wpad full 时生效)
                [ -s /etc/config/wireless ] || wifi config >/dev/null 2>&1
                if [ -s /etc/config/wireless ]; then
                        for dev in $(uci -q show wireless | grep -oE '^wireless\.radio[0-9]+' | sort -u); do
                                uci -q batch <<EOF
set $dev.ieee80211k='1'
set $dev.bss_transition='1'
set $dev.ieee80211r='1'
set $dev.ft_psk_generate_local='1'
EOF
                        done
                        uci commit wireless
                fi

                # 默认 root 密码 password (default-settings 包已剔除, 补位; 仅替换空密码行, 不覆盖用户已设密码)
                sed -i 's/root::0:0:99999:7:::/root:$1$V4UetPzk$CYXluq4wUazHjmCDBCqXF.:0:0:99999:7:::/' /etc/shadow

                # 常用工具软链与 opkg 国内镜像源 (default-settings 包已剔除, 补位)
                ln -sf /sbin/ip /usr/bin/ip
                [ -f /etc/opkg/distfeeds.conf ] && {
                        sed -i 's#http://downloads.openwrt.org#https://mirrors.cloud.tencent.com/lede#g' /etc/opkg/distfeeds.conf
                        sed -i "s/# //g" /etc/opkg/distfeeds.conf
                        sed -i '/openwrt_luci/ { s/snapshots/releases\/18.06.8/g; }' /etc/opkg/distfeeds.conf
                }

                # dnsmasq 日志静音 (default-settings 包已剔除, 补位)
                sed -i '/log-facility/d' /etc/dnsmasq.conf
                echo "log-facility=/dev/null" >> /etc/dnsmasq.conf
                ;;
esac

exit 0
