/*
 * MASELinK AP2600IFM (AR7161)
 *
 * 基于官方 OpenWrt master 的 ar7161_aruba_ap-175.dts 改造,
 * 硬件参数源自 mach-maselink-ap2600ifm.c(作者 Weijie Gao)。
 * 本机无 AP-175 的 i2c 扩展模块(i2c0/i2c-gpio 已删除)。
 */

#include "ar7100.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "maselink,ap2600ifm", "qca,ar7161";
	model = "MASELinK AP2600IFM";

	chosen {
		bootargs = "console=ttyS0,115200 mem=64M";
	};

	aliases {
		led-boot = &led_d24;
		led-failsafe = &led_d24;
		led-upgrade = &led_d24;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x04000000>;
	};

	/*
	 * 独立 MDIO syscon:仅覆盖 MDIO/MII 寄存器区(0x19000000),
	 * 不带 resets 属性。mdio0 通过 regmap 指向该节点后,
	 * 不会再触发 of_syscon_register(eth0) 去独占获取 reset#9,
	 * 从而消除与 ag71xx 主驱动之间的 -EBUSY 冲突。
	 */
	mdio_syscon: mdio-syscon@19000000 {
		compatible = "syscon";
		reg = <0x19000000 0x200>;
	};

	leds {
		compatible = "gpio-leds";

		led_d24: d24 {
			label = "green:d24";
			gpios = <&gpio 0 GPIO_ACTIVE_LOW>;
		};

		rf1 {
			label = "green:rf1";
			gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
		};

		d24top {
			label = "green:d24top";
			/* GPIO3 实测高电平点亮（2026-09-01），修正 LOWER -> HIGH */
			gpios = <&gpio 3 GPIO_ACTIVE_HIGH>;
		};

		rf2 {
			label = "green:rf2";
			/* GPIO4 实测高电平点亮（2026-09-01），修正 LOWER -> HIGH */
			gpios = <&gpio 4 GPIO_ACTIVE_HIGH>;
		};

		rf2top {
			label = "green:rf2top";
			gpios = <&gpio 5 GPIO_ACTIVE_LOW>;
		};

		rf1top {
			label = "green:rf1top";
			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
		};
	};
};

&pcie0 {
	status = "okay";

	/* 无线卡使用卡内 EEPROM OTP MAC(实测跨重启稳定,如 00:1b:b1 / 90:a4:de)。
	 * 如需统一为 hwinfo 基址派生,可启用(注释保留):
	 * nvmem-cells = <&macaddr_hwinfo_0>;
	 * nvmem-cell-names = "mac-address";
	 * mac-address-increment = <1>;
	 */
	wifi@11,0 {
		compatible = "pci168c,0029";
		reg = <0x8800 0 0 0 0>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	wifi@12,0 {
		compatible = "pci168c,0029";
		reg = <0x9000 0 0 0 0>;
		#gpio-cells = <2>;
		gpio-controller;
	};
};

&mdio0 {
	status = "okay";

	/*
	 * regmap 指向独立 mdio_syscon(不带 resets),
	 * 避免解析 eth0 时和 ag71xx 主驱动抢 reset#9 触发 -EBUSY。
	 */
	regmap = <&mdio_syscon>;

	/*
	 * PHY 为 IC+ IP1001，MDIO 地址 1。
	 * 2026-08-30 Breed mdio 实测确认：ag71xx-mdio.0 read 1 2 -> 0243,
	 * read 1 3 -> 0d91，即 PHY ID 0x02430d91 = IP1001；地址 20 无响应。
	 * 与官方 AP-175 板值 @1 一致。
	 */
	phy1: ethernet-phy@1 {
		reg = <1>;
	};
};

&eth0 {
	status = "okay";

	/*
	 * MAC 取自 hwinfo 分区偏移 0x0(实测 2026-09-02):
	 * 00:27:1d:20:03:6f(00271D = Comba 京信 OUI)。
	 * 原 macaddr@1c 位置实测是 ASCII 序列号, 且未绑定 eth0,
	 * 导致每次上电 LAN MAC 随机(瘦 AP 模式 DHCP IP 漂移)。
	 */
	nvmem-cells = <&macaddr_hwinfo_0>;
	nvmem-cell-names = "mac-address";

	/* 与 ar7100.dtsi 默认值相同,显式声明以文档化 */
	pll-data = <0x00110000 0x00001099 0x00991099>;

	phy-mode = "rgmii";
	phy-handle = <&phy1>;
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/*
			 * 布局对齐 Breed 的 ATH-SDK-16MB flash layout:
			 * bootloader 区 0x0-0x50000, 固件区 0x50000 起。
			 * 这样 Breed WebUI 选 ATH-SDK-16MB 布局上传 sysupgrade
			 * 即可一键直刷, autoboot 也从 0x50000 引导。
			 */
			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x50000>;
				read-only;
			};

			partition@50000 {
				label = "firmware";
				reg = <0x50000 0xf90000>;
				compatible = "denx,uimage";
			};

			hwinfo: partition@fe0000 {
				label = "hwinfo";
				reg = <0xfe0000 0x10000>;
				read-only;

				/*
				 * 用 nvmem-cells 旧式写法(与官方 AP-105 一致, 6.6 ath79 全系如此)。
				 * 不能用 nvmem-layout/fixed-layout + mac-base: 需要
				 * CONFIG_NVMEM_LAYOUT_FIXED, 而 ath79 config-6.6 未开,
				 * 会导致 cell 解析失败(#nvmem-cell-cells = 1 found 0) -> MAC 随机。
				 * 真实 MAC 在偏移 0x0(Comba OUI 00:27:1d), 0x1c 处是 ASCII 序列号。
				 */
				compatible = "nvmem-cells";
				#address-cells = <1>;
				#size-cells = <1>;

				macaddr_hwinfo_0: macaddr@0 {
					reg = <0x0 0x6>;
				};
			};

			partition@ff0000 {
				label = "u-boot-env";
				reg = <0xff0000 0x10000>;
				read-only;
			};
		};
	};
};
